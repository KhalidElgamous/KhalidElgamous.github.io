# Copy this file to .env.local for local development.
# For GitHub Pages, set the same names as variables in your build workflow (see README).

# Free access key from https://web3forms.com (it is meant to be public).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=9b2222b9-5bc8-4613-bceb-67d81b3da5b2

# GitHub Pages only: "/<repo-name>" if the site is at https://<user>.github.io/<repo-name>/.
# Leave empty for a <user>.github.io repository or a custom domain.
NEXT_PUBLIC_BASE_PATH=